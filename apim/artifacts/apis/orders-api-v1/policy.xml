<!--
  Orders API v1 policy (policy-as-code, published by APIOps).

  Inherits the global policy with <base />: correlation id, security headers,
  standard error shape. Environment-specific values come from named values
  ({{tenant-id}}, {{api-audience}}) that apim/configuration.<env>.yaml sets,
  so this file is identical in every environment.

  Authentication : validate-jwt (issuer + audience)     -> 401
  Authorization  : GET needs Orders.Read, other methods Orders.Write -> 403
  Rate limit     : none on the Consumption tier (rate-limit-by-key is classic/v2 only)
  Backend        : named backend "orders-api", called with the gateway's managed identity
-->
<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(!context.Operation.UrlTemplate.EndsWith("/health"))">
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="A valid Microsoft Entra access token is required." require-scheme="Bearer" output-token-variable-name="jwt">
          <openid-config url="https://login.microsoftonline.com/{{tenant-id}}/v2.0/.well-known/openid-configuration" />
          <audiences>
            <audience>{{api-audience}}</audience>
          </audiences>
          <issuers>
            <issuer>https://sts.windows.net/{{tenant-id}}/</issuer>
            <issuer>https://login.microsoftonline.com/{{tenant-id}}/v2.0</issuer>
          </issuers>
        </validate-jwt>
        <choose>
          <when condition="@{
            var roles = ((Jwt)context.Variables["jwt"]).Claims.GetValueOrDefault("roles", "").Split(',').Select(r => r.Trim());
            var required = context.Request.Method == "GET" || context.Request.Method == "HEAD" ? "Orders.Read" : "Orders.Write";
            return !roles.Contains(required) && !(required == "Orders.Read" && roles.Contains("Orders.Write"));
          }">
            <return-response>
              <set-status code="403" reason="Forbidden" />
              <set-header name="X-Correlation-Id" exists-action="override">
                <value>@(context.Variables.GetValueOrDefault<string>("correlationId", context.RequestId.ToString()))</value>
              </set-header>
              <set-header name="X-Caller-Id" exists-action="override">
                <value>@(context.Variables.GetValueOrDefault<string>("callerId", "anonymous"))</value>
              </set-header>
              <set-header name="Content-Type" exists-action="override">
                <value>application/json</value>
              </set-header>
              <set-body>@(new JObject(new JProperty("error", new JObject(new JProperty("code", "Forbidden"), new JProperty("message", "The token does not carry the application permission this operation requires (Orders.Read for reads, Orders.Write for writes)."), new JProperty("correlationId", context.Variables.GetValueOrDefault<string>("correlationId", context.RequestId.ToString()))))).ToString())</set-body>
            </return-response>
          </when>
        </choose>
      </when>
    </choose>
    <set-backend-service backend-id="orders-api" />
    <authentication-managed-identity resource="{{api-audience}}" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
