{
  "properties": {
    "loggerId": "/loggers/appinsights",
    "alwaysLog": "allErrors",
    "verbosity": "information",
    "logClientIp": true,
    "httpCorrelationProtocol": "W3C",
    "sampling": {
      "samplingType": "fixed",
      "percentage": 100
    },
    "frontend": {
      "request":  { "headers": ["X-Correlation-Id", "User-Agent"], "body": { "bytes": 0 } },
      "response": { "headers": ["X-Correlation-Id", "Retry-After"], "body": { "bytes": 0 } }
    },
    "backend": {
      "request":  { "headers": ["X-Correlation-Id"], "body": { "bytes": 0 } },
      "response": { "headers": ["X-Correlation-Id"], "body": { "bytes": 0 } }
    }
  }
}
