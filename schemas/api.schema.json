{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/sampleworthy/cloudapiworkflow/schemas/api.schema.json",
  "title": "API onboarding metadata (apis/<name>/api.yaml)",
  "description": "Validated in CI before Terraform runs. Field names are camelCase; terraform/api-onboarding/*/locals.tf maps them onto the apim-api module.",
  "type": "object",
  "additionalProperties": false,
  "required": ["name", "displayName", "path", "authentication"],
  "properties": {
    "name": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]{1,40}-api$",
      "description": "APIM API id prefix and identifier-URI segment. Must end in -api and match the folder name."
    },
    "displayName": { "type": "string", "minLength": 3, "maxLength": 80 },
    "description": { "type": "string", "maxLength": 500 },
    "owner": { "type": "string", "pattern": "^[a-z0-9-]+$", "description": "Owning team; should match a CODEOWNERS entry." },
    "path": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$",
      "description": "Gateway path segment (no slashes, no version): the API is served at /<path>/<version>."
    },
    "version": { "type": "string", "pattern": "^v[0-9]+$", "default": "v1" },
    "versionSet": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$", "description": "Defaults to name. Set it when adding a new major version folder (e.g. orders-api-v2 -> orders-api)." },
    "revision": { "type": "integer", "minimum": 1, "default": 1 },
    "openapi": { "type": "string", "default": "openapi.yaml" },
    "policy": { "type": "string", "default": "policies/inbound.xml" },
    "product": { "type": "string", "enum": ["internal-apis", "partner-apis", "agent-apis"], "default": "internal-apis" },
    "subscriptionRequired": { "type": "boolean", "default": false },
    "backend": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "type": { "type": "string", "enum": ["app_service", "external", "mock"], "default": "app_service" },
        "url": { "type": "string", "pattern": "^https://" },
        "urlVariable": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Key in the environment's backend_urls tfvars map." }
      },
      "allOf": [
        {
          "if": { "properties": { "type": { "const": "external" } }, "required": ["type"] },
          "then": { "anyOf": [{ "required": ["url"] }, { "required": ["urlVariable"] }] }
        }
      ]
    },
    "backendUrlVariable": { "type": "string", "pattern": "^[a-z][a-z0-9_]*$", "description": "Legacy alias for backend.urlVariable." },
    "authentication": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "roles"],
      "properties": {
        "type": { "type": "string", "enum": ["entra"] },
        "audience": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$", "description": "Identifier-URI segment; defaults to name. Full audience is api://<tenant-id>/<audience>-<env>." },
        "roles": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "pattern": "^[A-Z][A-Za-z]+\\.[A-Z][A-Za-z]+$" },
          "additionalProperties": { "type": "string", "minLength": 3 },
          "description": "App roles exposed by the API: { \"Orders.Read\": \"description\" }."
        },
        "requiredRoles": { "type": "array", "items": { "type": "string" }, "minItems": 1, "description": "Any-of roles for read operations. Defaults to all roles." },
        "writeRoles": { "type": "array", "items": { "type": "string" }, "description": "Any-of roles additionally required for non-GET operations." },
        "allowedClients": { "type": "array", "items": { "type": "string", "enum": ["agent"] }, "default": ["agent"] }
      }
    },
    "rateLimit": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "calls": { "type": "integer", "minimum": 1, "maximum": 100000 },
        "renewalPeriod": { "type": "integer", "minimum": 1, "maximum": 3600 }
      }
    },
    "diagnostics": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": { "type": "boolean" },
        "samplingPercentage": { "type": "number", "minimum": 0, "maximum": 100 }
      }
    }
  }
}
