<!--
  Skills API policy (policy-as-code).

  Rendered by Terraform with templatefile(): every $${...} placeholder is
  filled from api.yaml and the platform, so this file carries no tenant ids,
  URLs or environment names. {{tenant-id}} is an APIM named value owned by
  the platform layer. <base /> inherits the global policy (correlation id,
  security headers, error shape) - do not re-implement those here.

  Read-only API: every operation except /health requires Skills.Read.
-->
<policies>
  <inbound>
    <base />
    <choose>
      <when condition="@(!context.Operation.UrlTemplate.EndsWith("/health"))">
        <validate-jwt header-name="Authorization" failed-validation-httpcode="401" failed-validation-error-message="A valid Microsoft Entra access token is required." require-scheme="Bearer" output-token-variable-name="jwt">
          <openid-config url="https://login.microsoftonline.com/{{tenant-id}}/v2.0/.well-known/openid-configuration" />
          <audiences>
%{ for a in audiences ~}
            <audience>${a}</audience>
%{ endfor ~}
          </audiences>
          <issuers>
            <issuer>https://sts.windows.net/{{tenant-id}}/</issuer>
            <issuer>https://login.microsoftonline.com/{{tenant-id}}/v2.0</issuer>
          </issuers>
          <required-claims>
            <claim name="roles" match="any">
%{ for r in required_roles ~}
              <value>${r}</value>
%{ endfor ~}
            </claim>
          </required-claims>
        </validate-jwt>
        <!-- Per-caller limit keyed by the token subject (works on every tier incl. Consumption) -->
        <rate-limit-by-key calls="${rate_limit_calls}" renewal-period="${rate_limit_period}" counter-key="@(((Jwt)context.Variables["jwt"]).Subject ?? context.Request.IpAddress)" />
      </when>
    </choose>
    <!-- Route to the named backend and authenticate to it as the gateway's managed identity -->
    <set-backend-service backend-id="${backend_id}" />
    <authentication-managed-identity resource="${backend_audience}" />
  </inbound>
  <backend>
    <base />
  </backend>
  <outbound>
    <base />
  </outbound>
  <on-error>
    <base />
  </on-error>
</policies>
