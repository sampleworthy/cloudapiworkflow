<!--
  Global policy: applied to every API in the shared APIM instance.
  Owned by the platform team. API policies inherit this via <base />.

  Responsibilities kept here so API teams never re-implement them:
    * correlation id propagation (X-Correlation-Id)
    * hop-by-hop / hostile header hygiene
    * common security response headers
    * one standard JSON error shape, no backend detail leakage
-->
<policies>
  <inbound>
    <!-- Reuse a caller-supplied correlation id, otherwise mint one from the gateway request id -->
    <set-variable name="correlationId" value="@(context.Request.Headers.GetValueOrDefault("X-Correlation-Id", context.RequestId.ToString()))" />
    <set-header name="X-Correlation-Id" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <!-- Caller identity (azp/appid claim of the bearer token, if any) for attribution in telemetry.
         Agents, applications and demo clients all show up here by their client id. -->
    <set-variable name="callerId" value="@{
      var jwt = context.Request.Headers.GetValueOrDefault("Authorization", "").AsJwt();
      if (jwt == null) { return "anonymous"; }
      var azp = jwt.Claims.GetValueOrDefault("azp", "");
      return string.IsNullOrEmpty(azp) ? jwt.Claims.GetValueOrDefault("appid", "unknown") : azp;
    }" />
    <set-header name="X-Caller-Id" exists-action="override">
      <value>@((string)context.Variables["callerId"])</value>
    </set-header>
    <!-- Never forward the consumer's subscription key or forwarded-for chain to backends -->
    <set-header name="Ocp-Apim-Subscription-Key" exists-action="delete" />
    <set-header name="X-Forwarded-For" exists-action="override">
      <value>@(context.Request.IpAddress)</value>
    </set-header>
  </inbound>
  <backend>
    <forward-request timeout="30" />
  </backend>
  <outbound>
    <set-header name="X-Correlation-Id" exists-action="override">
      <value>@((string)context.Variables["correlationId"])</value>
    </set-header>
    <set-header name="X-Caller-Id" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault<string>("callerId", "anonymous"))</value>
    </set-header>
    <set-header name="Strict-Transport-Security" exists-action="override">
      <value>max-age=31536000; includeSubDomains</value>
    </set-header>
    <set-header name="X-Content-Type-Options" exists-action="override">
      <value>nosniff</value>
    </set-header>
    <set-header name="Cache-Control" exists-action="skip">
      <value>no-store</value>
    </set-header>
    <set-header name="X-Powered-By" exists-action="delete" />
    <set-header name="Server" exists-action="delete" />
  </outbound>
  <on-error>
    <set-header name="X-Correlation-Id" exists-action="override">
      <value>@(context.Variables.GetValueOrDefault<string>("correlationId", context.RequestId.ToString()))</value>
    </set-header>
    <set-header name="Content-Type" exists-action="override">
      <value>application/json</value>
    </set-header>
    <!-- Normalise every gateway-side failure to one shape. Backend bodies are never echoed. -->
    <set-body>@{
      var status = context.Response.StatusCode;
      var reason = context.LastError?.Reason ?? "Error";
      var message = status == 401 ? "Unauthorized"
                  : status == 403 ? "Forbidden"
                  : status == 429 ? "Too many requests"
                  : status >= 500 ? "Upstream error"
                  : (context.LastError?.Message ?? "Request failed");
      return new JObject(
        new JProperty("error", new JObject(
          new JProperty("code", reason),
          new JProperty("message", message),
          new JProperty("correlationId", context.Variables.GetValueOrDefault<string>("correlationId", context.RequestId.ToString()))
        ))
      ).ToString();
    }</set-body>
  </on-error>
</policies>
